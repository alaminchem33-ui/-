        // ==================== 1. GUARANTEED DIRECT PDF DOWNLOAD (MOBILE + WEBVIEW + DESKTOP) ====================
        async function downloadPDFReport() {
            const btn = document.getElementById("btn-download-pdf");
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>${state.lang === 'bn' ? 'তৈরি হচ্ছে...' : 'Generating...'}</span>`;

            const calc = populateCleanReportTemplate();
            const fileName = `Mess_Meal_Report_${state.monthEn.replace(/[^a-zA-Z0-9]/g, '_')}.pdf`;
            const reportEl = document.getElementById("pdf-print-report");

            try {
                // Temporarily make visible off-screen for crisp rendering
                reportEl.classList.remove("hidden");
                reportEl.style.position = "fixed";
                reportEl.style.left = "-9999px";
                reportEl.style.top = "0";
                reportEl.style.zIndex = "-1";

                if (typeof html2pdf !== "undefined") {
                    const opt = {
                        margin: [6, 6, 6, 6],
                        filename: fileName,
                        image: { type: 'jpeg', quality: 0.98 },
                        html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff' },
                        jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' }
                    };
                    await html2pdf().set(opt).from(reportEl).save();
                    showToast(state.lang === 'bn' ? 'PDF ফাইল সফলভাবে ডাউনলোড হয়েছে!' : 'PDF file downloaded successfully!');
                } else {
                    generateVectorJsPDF(calc, fileName);
                }
            } catch (err) {
                console.warn("html2pdf fallback to jsPDF:", err);
                generateVectorJsPDF(calc, fileName);
            } finally {
                reportEl.classList.add("hidden");
                reportEl.style.position = "";
                reportEl.style.left = "";
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }

        // Fallback Vector PDF Generator (Works even in restricted Android WebViews)
        function generateVectorJsPDF(calc, fileName) {
            if (!window.jspdf || !window.jspdf.jsPDF) {
                triggerPrintReport();
                return;
            }
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({ orientation: "landscape", unit: "mm", format: "a4" });

            doc.setFontSize(15);
            doc.text(`Mess Meal & Bazar Report - ${state.monthEn}`, 14, 14);
            doc.setFontSize(10);
            doc.text(`Total Deposit: ${fmt(calc.totalDeposit, 2)}  |  Total Bazar: ${fmt(calc.totalBazar, 2)}  |  Remained: ${fmt(calc.remainedCash, 2)}  |  Meal Rate: ${fmt(calc.mealRate, 2)}`, 14, 21);

            const head = [["#", "Name", "Prev. Bal", "Deposit", "Total", "Meals", "Rate", "Cost/Meal", "Chef Cost", "Feast", "Total Cost", "Net Balance"]];
            const body = calc.rows.map((r, i) => [
                i + 1,
                r.name + (r.isChef ? " (Chef)" : ""),
                fmtSmart(r.prev),
                fmt(r.deposit, 0),
                fmtSmart(r.total),
                fmt(r.mealQty, 1),
                r.mealQty > 0 ? fmt(r.mealRate, 2) : "-",
                r.displayCostMeal > 0 ? fmt(r.displayCostMeal, 2) : "-",
                r.chefShare > 0 ? fmt(r.chefShare, 2) : "-",
                r.feastCost > 0 ? fmt(r.feastCost, 2) : "-",
                r.totalCost > 0 ? fmt(r.totalCost, 2) : "-",
                fmt(r.netBalance, 2)
            ]);
            body.push([
                "", "TOTAL", fmt(calc.totalPrev, 2), fmt(calc.totalDeposit, 2), fmt(calc.totalFund, 2),
                fmt(calc.totalAllMeals, 1), fmt(calc.mealRate, 2), fmt(calc.sumCostMeal, 2),
                fmt(calc.sumChefCost, 2), fmt(calc.sumFeastCost, 2), fmt(calc.sumTotalCost, 2), fmt(calc.sumNetBalance, 2)
            ]);

            doc.autoTable({
                head,
                body,
                startY: 25,
                styles: { fontSize: 8, cellPadding: 1.5 },
                headStyles: { fillColor: [30, 58, 138] },
                theme: "grid"
            });

            doc.save(fileName);
            showToast(state.lang === 'bn' ? 'PDF ফাইল ডাউনলোড হয়েছে!' : 'PDF downloaded!');
        }

